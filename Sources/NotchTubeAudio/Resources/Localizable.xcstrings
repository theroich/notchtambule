    "settings.autopaste.caption" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When clicking a history row, the item is copied to the clipboard, the notch closes, and it is pasted directly (⌘V) into the application and field where the cursor was. Hold the ⌥ (Option) key while clicking to force “copy only”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al pulsar sobre una fila del historial, el elemento se copia al portapapeles, el notch se cierra y se pega directamente (⌘V) en la aplicación y el campo donde estaba el cursor. Mantén pulsada la tecla ⌥ (Opción) al hacer clic para forzar «solo copiar»."
          }
        }
      }
    },
